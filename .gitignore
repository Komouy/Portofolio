# ============================================================
# Portofolio - .gitignore
# ============================================================

# ---- Dependencies ----
node_modules/
.pnp
.pnp.js

# ---- Production & Build Outputs ----
dist/
dist-ssr/
build/
*.local

# ---- Environment Variables & Secrets ----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ---- Logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- AI / Tooling Caches ----
.aistudio/
.gemini/

# ---- OS / Editor ----
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# ---- Folder profil Chrome / cache yang dulu nyasar ke checkpoint Cline ----
_cudv/
_cvchk/
*_cudv/
*_cvchk/

# ---- File besar & download belum selesai ----
*.mp4
*.crdownload
*.zip
*.rar
*.psd
*.ai

# ---- Backup lokal ----
backup/
*.bak

